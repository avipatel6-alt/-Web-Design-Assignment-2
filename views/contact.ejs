<%- include('partials/header', { title: 'Contact', active: 'contact' }) %>

<main class="contact-page container py-5">
    <div class="row align-items-center g-5">

    <!-- the same title and heading -->
    <div class="col-lg-5">
        <p class="little-label">// get in touch</p> 
        <h1 class="page-title">Let’s <span class="gradient-text">talk</span></h1>
        <p class="contact-lead"> Have a project, a co-op role, or just want to say hi? My inbox is open. </p>
        <ul class="contact-list list-unstyled">
            <li><span class="ci-icon"><i class="fa-solid fa-envelope"></i></span> Avi.patel6@ontariotechu.net</li>
            <li><a href="https://linkedin.com/in/avi-patel-122294401" target="_blank" rel="noopener">
            <span class="ci-icon"><i class="fa-brands fa-linkedin"></i></span> LinkedIn</a></li>
            <li><a href="https://github.com/avipatel6-alt" target="_blank" rel="noopener">
            <span class="ci-icon"><i class="fa-brands fa-github"></i></span> GitHub</a></li>
            <li><span class="ci-icon"><i class="fa-solid fa-location-dot"></i></span> Oshawa, ON</li>
        </ul>
    </div>

    <!-- the actual form with cards glow on hover effect -->
    <div class="col-lg-7">
      <form class="contact-card" action="/contact" method="POST">
        <div class="row g-3">
          <div class="col-md-6">
            <label for="name" class="form-label">Name</label>
            <input type="text" id="name" name="name" class="form-control glow-input" required>
          </div>
          <div class="col-md-6">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" class="form-control glow-input" required>
          </div>
          <div class="col-12">
            <label for="message" class="form-label">Message</label>
            <textarea id="message" name="message" rows="6" class="form-control glow-input" required></textarea>
          </div>
          <div class="col-12">
            <button type="submit" class="btn btn-glow" style="width:600px; height:60px;">
              <i class="fa-solid fa-paper-plane me-2"></i>Send message
            </button>
          </div>
        </div>
      </form>
    </div>

  </div>
</main>

<%- include('partials/footer') %>